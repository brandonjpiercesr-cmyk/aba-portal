# ⬡B:repo.env_example:GUARD:key_names_only_never_a_value:20260726⬡
# CLAIR FIX01 HOLE-3. lib/config.js used to carry a live Supabase SERVICE ROLE key, a live Nylas
# key, a live Render key and a live Vercel token as literal source defaults, and lib/firebase.js
# carried the Firebase project config plus eleven real personal email addresses. All of it now
# comes from here, and every one of those values must be treated as BURNED and rotated: they were
# committed, and untracking a value does not remove it from git history.
#
# Copy to .env.local for development. Set the same names in the deployment environment.
# NEVER put a value in this file.

# ---------------------------------------------------------------------------
# PUBLIC. Next.js inlines every NEXT_PUBLIC_ value into the browser bundle.
# Only put things here that are safe for anyone to read.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The ANON key only. It is RLS-scoped by design. The service role key is NEVER a NEXT_PUBLIC_ value.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ABACIA_URL=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma separated admin email allowlist. Empty means nobody is an admin, which is the correct
# failure for an unconfigured deploy. This gate is client-readable and is a hint, not authorization.
NEXT_PUBLIC_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# SERVER ONLY. Never NEXT_PUBLIC_. Read through the functions in lib/config.js so a client
# import can never evaluate them.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_KEY=
NYLAS_API_KEY=
RENDER_API_KEY=
VERCEL_TOKEN=

# Nylas grants as JSON, because they are real people and a person is never a literal in source:
#   {"grant_key":{"id":"<grant id>","email":"<address>","label":"<display name>"}}
# Unset means no mailbox is read at all. It is never guessed.
NYLAS_GRANTS_JSON=
